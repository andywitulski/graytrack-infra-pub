# Managed by Ansible (labstack-infra). Manual edits will be reverted (role openbao).
# Read by systemd (EnvironmentFile) for openbao.service. Holds the seal key: mode 0640, root:openbao.
BAO_PG_CONNECTION_URL=postgres://{{ openbao_pg_user }}:{{ openbao_pg_password | urlencode }}@{{ openbao_pg_host }}:5432/{{ openbao_pg_db }}?sslmode=verify-full&sslrootcert=/etc/openbao/pg-ca.pem
BAO_SEAL_KEY={{ openbao_seal_key }}
{% if openbao_seal_previous_key_id %}
BAO_SEAL_PREVIOUS_KEY={{ openbao_seal_previous_key }}
{% endif %}
