# Managed by Ansible (labstack-infra): Stalwart mail server (docs/howto/mail.md)
[Unit]
Description=Stalwart mail server
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=stalwart
Group=stalwart
# STALWART_RECOVERY_ADMIN: break-glass admin, also what Ansible uses on the loopback management listener
EnvironmentFile={{ mail_config_dir }}/env
ExecStart=/usr/local/bin/stalwart --config {{ mail_config_dir }}/config.json
Restart=on-failure
RestartSec=5
LimitNOFILE=65536
# IMAP 993, submission 465, HTTPS 443 without running as root
AmbientCapabilities=CAP_NET_BIND_SERVICE
CapabilityBoundingSet=CAP_NET_BIND_SERVICE
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
ReadWritePaths={{ mail_data_dir }}

[Install]
WantedBy=multi-user.target
