# Managed by Ansible (labstack-infra).
services:
  caddy:
    build: .
    image: labstack/caddy:{{ caddy_version }}
    restart: unless-stopped
    ports:
      - "80:80"
      - "443:443"
      - "443:443/udp"
    env_file: .env
    # Logs go to the journal tagged "caddy"; the Wazuh agent forwards them (docker compose logs still works)
    logging:
      driver: journald
      options:
        tag: caddy
    volumes:
      - ./conf:/etc/caddy:ro
      - caddy_data:/data
      - caddy_config:/config

volumes:
  caddy_data: {}
  caddy_config: {}
