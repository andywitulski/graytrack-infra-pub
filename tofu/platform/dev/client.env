# Where the clients reach the platform (see tofu/platform/prod/client.env). Addresses must match main.tf.
PLATFORM_PG_HOST=__DEV_NET__.60
PLATFORM_PG_PORT=5432
PLATFORM_PG_DB=tofu_state
PLATFORM_PG_USER=tofu
PLATFORM_PG_CA=ansible/files/dev/pg01-ca.pem
PLATFORM_BAO_ADDR=https://__DEV_NET__.61:8200
# bao01-trust.pem: bao01's per-host CA plus ca01's root (roles/openbao writes it once ca01 exists and
# moves the listener to a ca01 certificate). Until it exists, bin/lib/platform.sh falls back to bao01-ca.pem.
PLATFORM_BAO_CA=ansible/files/dev/bao01-trust.pem
PLATFORM_CA_URL=https://__DEV_NET__.62
PLATFORM_CA_ROOT=ansible/files/dev/ca01-root.pem
PLATFORM_BAO_AUTH=approle
