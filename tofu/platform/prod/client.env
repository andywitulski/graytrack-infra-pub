# Where the clients reach the platform: bin/lib/platform.sh sources this for bin/tf, bin/tf-ak,
# bin/tf-platform, bin/tf-bao and bin/bao-*. Nothing secret. Addresses must match main.tf.
# The CA files are written by playbooks/platform.yml (role host_tls) and committed: they are public.
PLATFORM_PG_HOST=__MGMT_NET__.22
PLATFORM_PG_PORT=5432
PLATFORM_PG_DB=tofu_state
PLATFORM_PG_USER=tofu
PLATFORM_PG_CA=ansible/files/prod/pg01-ca.pem
PLATFORM_BAO_ADDR=https://__MGMT_NET__.23:8200
# bao01-trust.pem: bao01's per-host CA plus ca01's root (roles/openbao writes it once ca01 exists and
# moves the listener to a ca01 certificate). Until it exists, bin/lib/platform.sh falls back to bao01-ca.pem.
PLATFORM_BAO_CA=ansible/files/prod/bao01-trust.pem
PLATFORM_CA_URL=https://__MGMT_NET__.24
PLATFORM_CA_ROOT=ansible/files/prod/ca01-root.pem
# How bin/ap logs in to OpenBao: approle (secret ID in sops) or cert (short-lived X.509 from ca01).
# Switch to cert once tofu/openbao/prod has the cert auth method (docs/howto/certificate-authority.md).
PLATFORM_BAO_AUTH=cert
