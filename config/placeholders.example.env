# Every placeholder token used in this repository, with an example value.
# Copy outside the repository (or to a private fork), edit, then run:
#   bin/render-placeholders /path/to/placeholders.env
# Network tokens are the first three octets of a /24.

# --- Production trust zones
__LAN_NET__=10.20.0            # Internal zone: workstations and household/office clients
__MGMT_NET__=10.20.100         # VLAN 100: hypervisors, platform tier, backup server, PAW
__SEC_NET__=10.20.110          # VLAN 110: SIEM
__SVC_NET__=10.20.120          # VLAN 120: application services
__DMZ_NET__=10.20.125          # VLAN 125: reverse proxy
__STOR_NET__=10.20.130         # VLAN 130: storage (NFS)

# --- Lab node and nested development environment
__DEV_NET__=10.30.0            # nested dev cluster
__DEV_STOR_NET__=10.30.130     # nested dev storage
__KALI_NET__=10.31.0           # internet-only security testing network
__TB_NET__=10.32.0             # point-to-point admin link (a /30 in the .0 block)

# --- Individual values
__TAILNET_IP_PHONE__=100.64.0.10    # overlay address of a trusted phone
__TAILNET_IP_LAPTOP__=100.64.0.11   # overlay address of a trusted laptop
__LAB_DISK_ID__=nvme-VENDOR_MODEL_SERIAL   # /dev/disk/by-id name of the lab node's VM disk
__AGE_PUBLIC_KEY__=age1replacewithyourpublickey
__BASE64_ROOT_CA_DER__=REPLACE_WITH_BASE64_OF_ROOT_CA_DER

# --- Plain-text values replaced everywhere (not tokens, but safe to rewrite)
BASE_DOMAIN=example.com
