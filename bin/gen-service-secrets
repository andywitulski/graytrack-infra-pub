#!/usr/bin/env bash
# bin/gen-service-secrets <dev|prod|labnode>
# Generates every self-generated service secret, WITHOUT overwriting keys that exist.
# Where they go (docs/howto/secrets-openbao.md): once the environment is cut over to OpenBao
# (secrets_file_version 2), into kv/services/<env>/<service>, except the sops_only keys (secrets/policy.yml),
# which stay in sops. Before the cutover (and always for dev, which has no OpenBao), everything into sops.
# Issued secrets (outpost tokens, PBS token, DNS API credentials) are set to PENDING here and filled later
# with bin/bao-secret (or `sops set` before the cutover). OIDC client secrets and the Jellyfin LDAP bind
# password are written by OpenTofu (bin/tf-ak) once cut over.
# Nothing is ever printed except key names.
set -euo pipefail

env=${1:?usage: bin/gen-service-secrets <dev|prod|labnode>}
case "$env" in dev) domain=dev.example.com ;; prod|labnode) domain=example.com ;; *) echo "unknown env: $env" >&2; exit 2 ;; esac
root=$(git -C "$(dirname "$0")" rev-parse --show-toplevel)
F="$root/ansible/inventories/$env/group_vars/all/secrets.sops.yml"
AK="$root/secrets/authentik-$env.enc.yaml"

# shellcheck source=lib/platform.sh
source "$root/bin/lib/platform.sh"
secrets_policy "$root"
penv=$(platform_of "$env")
backend=sops
if [[ -f $F ]] && [[ $(secrets_backend "$env" "$root") == openbao ]]; then
  backend=openbao
  platform_env "$penv" "$root"
  bao_root_token "$penv" "$root"
  bao_env_load "$env"
fi

b64()    { openssl rand -base64 "$1" | tr -d '\n'; }
pass()   { openssl rand -base64 "$1" | tr -d '\n/+='; }
b64url() { openssl rand -base64 32 | tr '+/' '-_' | tr -d '=\n'; }
# Wazuh enforces upper, lower, digit and symbol; symbols limited to what the wazuh roles accept
wpass()  {
  local p
  while :; do
    p="$(pass 24).$(pass 6)-"
    [[ $p =~ [A-Z] && $p =~ [a-z] && $p =~ [0-9] ]] && { printf '%s' "$p"; return; }
  done
}

has() { sops decrypt --extract "[\"$2\"]" "$1" >/dev/null 2>&1; }
put() { # file key value
  if [[ $backend == openbao && $1 == "$F" && ! $2 =~ $GT_SOPS_ONLY ]]; then
    if [[ $2 =~ $GT_TOFU_OWNED ]]; then echo "tofu  $2 (bin/tf-ak $penv apply writes it)"; return; fi
    if printf '%s' "$GT_BAO_SECRETS" | jq -e --arg k "$2" 'has($k)' >/dev/null; then echo "keep  $2"; return; fi
    printf '%s' "$3" | jq -Rsc --arg k "$2" '{($k): .}' | bao_kv_patch "services/$env/${2%%_*}"
    echo "set   $2 (OpenBao)"
    return
  fi
  if has "$1" "$2"; then echo "keep  $2"; else sops set "$1" "[\"$2\"]" "\"$3\""; echo "set   $2"; fi
}
new_sops() { # file first-line: create an encrypted file holding one non-secret key
  [[ -f $1 ]] && return
  mkdir -p "$(dirname "$1")"
  printf '%s\n' "$2" > "$1"
  sops encrypt --in-place "$1"
  echo "new   $1"
}

new_sops "$F" "secrets_file_version: 1"

pending() {
  echo
  echo "Still PENDING (fill when issued):"
  sops decrypt "$1" | grep -E ': "?PENDING"?$' | cut -d: -f1 || true
  if [[ $backend == openbao ]]; then
    bao_env_load "$env"
    printf '%s' "$GT_BAO_SECRETS" | jq -r 'to_entries[] | select(.value == "PENDING") | "\(.key) (bin/bao-secret '"$env"' set \(.key))"'
  fi
}

# ---- labnode: prod's platform tier and SIEM; only what labnode itself runs (gpu01's database, its backups)
if [[ $env == labnode ]]; then
  P="$root/ansible/inventories/prod/group_vars/all/secrets.sops.yml"
  put "$F" rag_pg_password "$(pass 32)"
  # siem01 is prod's, so is the enrollment password. Copied: after a rotation in prod, delete the key
  # here (bin/bao-secret labnode unset, or sops unset before the cutover) and run this again.
  if [[ $(secrets_backend prod "$root") == openbao ]]; then
    [[ -n ${BAO_TOKEN:-} ]] || { platform_env prod "$root"; bao_root_token prod "$root"; }
    bao_env_load prod
    tok=$(printf '%s' "$GT_BAO_SECRETS" | jq -r '.wazuh_enrollment_password')
  else
    tok=$(sops decrypt --extract '["wazuh_enrollment_password"]' "$P")
  fi
  put "$F" wazuh_enrollment_password "$tok"
  unset tok
  put "$F" pbs_cluster_token_secret PENDING   # pbs01:/root/pbs-labnode-token.json (roles/pbs, pbs_extra_tokens)
  put "$F" pbs_encryption_key       PENDING   # labnode's own key, created by playbooks/backups.yml (autogen)
  pending "$F"
  exit 0
fi

# ---- self-generated
put "$F" authentik_secret_key         "$(b64 60)"
put "$F" authentik_pg_pass            "$(pass 32)"
put "$F" authentik_bootstrap_password "$(pass 24)"
put "$F" authentik_bootstrap_token    "$(pass 48)"
put "$F" forgejo_secret_key           "$(pass 48)"
put "$F" forgejo_internal_token       "$(pass 48)"
put "$F" forgejo_jwt_secret           "$(b64url)"
put "$F" forgejo_lfs_jwt_secret       "$(b64url)"
put "$F" forgejo_db_pass              "$(pass 32)"
put "$F" forgejo_admin_password       "$(pass 24)"
put "$F" nextcloud_db_pass            "$(pass 32)"
put "$F" nextcloud_admin_pass         "$(pass 24)"
put "$F" collabora_admin_pass         "$(pass 24)"
put "$F" audiobookshelf_root_password "$(pass 32)"
put "$F" vaultwarden_db_pass          "$(pass 32)"
put "$F" fleet_mysql_password         "$(pass 32)"
put "$F" fleet_mysql_root_password    "$(pass 32)"
# Fleet encrypts what it keeps in MySQL with this (the APNs certificate and key among them): lose it, and
# MDM has to be set up again and every device re-enrolled (docs/howto/mdm.md)
put "$F" fleet_server_private_key     "$(b64 32)"
put "$F" fleet_enroll_secret          "$(pass 32)"
put "$F" mail_fallback_admin_secret    "$(pass 32)"   # Stalwart break-glass admin (docs/howto/mail.md)
# One per person in mail_users (inventories/common/group_vars/mail.yml): their Stalwart password, which the
# sync logs in with. Devices use app passwords from the account portal instead.
put "$F" mail_user_alice_password      "$(pass 32)"
put "$F" mail_user_bob_password    "$(pass 32)"
put "$F" wazuh_admin_password         "$(wpass)"
put "$F" wazuh_kibanaserver_password  "$(wpass)"
put "$F" wazuh_api_password           "$(wpass)"
put "$F" wazuh_enrollment_password    "$(wpass)"
put "$F" wazuh_saml_exchange_key       "$(openssl rand -hex 32)"
# platform tier (tofu/platform/<env>): pg01 roles, and OpenBao's static seal key (32 random bytes, base64).
# The seal key protects everything in OpenBao: losing it makes OpenBao's storage unreadable for good.
put "$F" tofu_state_pg_password       "$(pass 32)"
put "$F" openbao_pg_password          "$(pass 32)"
put "$F" openbao_seal_key             "$(b64 32)"
put "$F" stepca_pg_password           "$(pass 32)"

# ---- issued elsewhere: filled later
put "$F" authentik_ldap_outpost_token  PENDING   # Authentik API, view_key of the ldap outpost token
put "$F" authentik_proxy_outpost_token PENDING   # same, proxy outpost
# OpenTofu writes these into OpenBao once cut over; before that, piped from bin/tf-ak <env> output -raw ...
put "$F" forgejo_oidc_client_secret    PENDING
put "$F" nextcloud_oidc_client_secret  PENDING
put "$F" audiobookshelf_oidc_client_secret PENDING
put "$F" vaultwarden_oidc_client_secret PENDING
put "$F" headscale_oidc_client_secret PENDING
put "$F" jellyfin_ldap_bind_password   PENDING
put "$F" fleet_gitops_token            PENDING   # API-only Fleet admin for bin/fleet-gitops, docs/howto/mdm.md
put "$F" caddy_dns_user                PENDING   # ZoneEdit (same account in every env)
put "$F" caddy_dns_api_token           PENDING
put "$F" pbs_cluster_token_secret      PENDING   # left on the PBS host by the pbs role
put "$F" pbs_encryption_key            PENDING   # created by playbooks/backups.yml (autogen)

# ---- credentials for bin/tf-ak (Authentik configuration as code); its API token is the bootstrap token
new_sops "$AK" "AUTHENTIK_URL: \"https://auth.$domain\""
if [[ $backend == openbao ]]; then
  bao_env_load "$env"
  tok=$(printf '%s' "$GT_BAO_SECRETS" | jq -r '.authentik_bootstrap_token')
else
  tok=$(sops decrypt --extract '["authentik_bootstrap_token"]' "$F")
fi
put "$AK" AUTHENTIK_TOKEN "$tok"
unset tok
put "$AK" TF_VAR_state_passphrase "$(b64 32)"

pending "$F"
