#!/usr/bin/env bash
# Usage: bin/bao-secret <prod|labnode> set <key>        value from a hidden prompt, or piped on stdin
#        bin/bao-secret <prod|labnode> check <key>      where it lives and how long it is (never the value)
#        bin/bao-secret <prod|labnode> list             every key of the environment, by service
#        bin/bao-secret <prod|labnode> unset <key>
#        bin/bao-secret <prod|labnode> copy <key>       onto the clipboard, never on screen (pbcopy, wl-copy, xclip)
# One service secret in OpenBao, kv/services/<env>/<service> (the key name up to the first underscore).
# For secrets that are issued somewhere else and set by hand: PBS tokens, outpost tokens, API credentials.
# Generated ones come from bin/gen-service-secrets. sops_only keys (secrets/policy.yml) go to sops with
# `sops set`, tofu_owned ones are written by OpenTofu: both are refused here.
#
#   bin/bao-secret prod set pbs_cluster_token_secret
#   ssh ansible@pbs01 'sudo jq -r .value /root/pbs-labnode-token.json' | bin/bao-secret labnode set pbs_cluster_token_secret
set -euo pipefail

usage() { sed -n '2,6p' "$0" | sed 's/^# //' >&2; exit 2; }
env=${1:-}
cmd=${2:-}
key=${3:-}
case "$env" in prod | labnode) ;; *) usage ;; esac
case "$cmd" in set | check | unset | copy) [[ $key =~ ^[a-z0-9]+_[a-z0-9_]+$ ]] || usage ;; list) ;; *) usage ;; esac
root=$(git -C "$(dirname "$0")" rev-parse --show-toplevel)

# shellcheck source=lib/platform.sh
source "$root/bin/lib/platform.sh"
secrets_policy "$root"
penv=$(platform_of "$env")
platform_env "$penv" "$root"
bao_root_token "$penv" "$root"
path="services/$env/${key%%_*}"

if [[ $cmd == set || $cmd == unset ]]; then
  if [[ $key =~ $GT_SOPS_ONLY ]]; then
    echo "$key stays in sops (secrets/policy.yml, sops_only): sops set ansible/inventories/$env/group_vars/all/secrets.sops.yml '[\"$key\"]' ..." >&2
    exit 1
  fi
  if [[ $key =~ $GT_TOFU_OWNED ]]; then
    echo "$key is written by OpenTofu (bin/tf-ak $penv apply), not by hand" >&2
    exit 1
  fi
fi

case "$cmd" in
  set)
    if [[ -t 0 ]]; then
      read -rs -p "$key ($env): " value
      echo
    else
      value=$(cat) # trailing newlines dropped
    fi
    [[ -n $value ]] || { echo "empty value, nothing stored" >&2; exit 1; }
    printf '%s' "$value" | jq -Rsc --arg k "$key" '{($k): .}' | bao_kv_patch "$path"
    unset value
    echo "set     kv/$path $key"
    ;;
  check)
    bao_env_load "$env"
    where=$(printf '%s' "$GT_BAO_PATHS" | jq -r --arg k "$key" '.[$k] // empty')
    if [[ -z $where ]]; then
      echo "$key: not in OpenBao ($env)"
      exit 1
    fi
    printf '%s' "$GT_BAO_SECRETS" | jq -r --arg k "$key" --arg w "$where" \
      '.[$k] | if . == "PENDING" then "\($k): PENDING in kv/\($w)" else "\($k): kv/\($w), \(tostring | length) characters" end'
    ;;
  list)
    bao_env_load "$env"
    printf '%s' "$GT_BAO_PATHS" | jq -r 'to_entries | group_by(.value)[] | "kv/\(.[0].value): \(map(.key) | join(", "))"'
    ;;
  unset)
    bao_kv_unset "$path" "$key"
    echo "removed kv/$path $key"
    ;;
  copy)
    # For the few generated secrets a person has to type once (a mailbox password into its portal, then
    # into Vaultwarden). The value goes from OpenBao to the clipboard without touching the terminal.
    if command -v pbcopy > /dev/null; then clip=(pbcopy)
    elif command -v wl-copy > /dev/null; then clip=(wl-copy)
    elif command -v xclip > /dev/null; then clip=(xclip -selection clipboard)
    else echo "no clipboard tool (pbcopy, wl-copy, xclip)" >&2; exit 1; fi
    bao_env_load "$env"
    printf '%s' "$GT_BAO_SECRETS" | jq -er --arg k "$key" '.[$k] // empty | select(. != "PENDING")' | tr -d '\n' | "${clip[@]}" \
      || { echo "$key: not set in OpenBao ($env)" >&2; exit 1; }
    echo "$key copied to the clipboard; paste it, then copy something else over it"
    ;;
esac
